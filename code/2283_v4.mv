[164]<10   # '\n'

# Map inputs to start positions
[49]<100  # '1' -> position 100
[50]<150  # '2' -> position 150

# Get start position
C<[A]

# Output 5 characters for n=1, 15 for n=2
# For n=1: 5 chars
# For n=2: 15 chars

# Just output 5 or 15 characters based on A
# Use D as counter

# If A==49: D=5
# If A==50: D=15
[49]<5
[50]<15
D<[A]

# Output D characters starting from C
E<[C]
O<E
F<1
C<C+F
D<D-F  # Can't decrement!

# Problem: we can't decrement or do arithmetic

