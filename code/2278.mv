# i++ problem
# Read ASCII '0'-'9' and output the next digit (mod 10)
# '0' (48) -> '1' (49)
# '9' (57) -> '0' (48)

# Read character into A
A<I

# Create lookup table for increment
# mem[48] = 49 ('0' -> '1')
# mem[49] = 50 ('1' -> '2')
# ...
# mem[56] = 57 ('8' -> '9')
# mem[57] = 48 ('9' -> '0')

[48]<49
[49]<50
[50]<51
[51]<52
[52]<53
[53]<54
[54]<55
[55]<56
[56]<57
[57]<48

# Now lookup: mem[A] contains the result
B<[A]

# Output result
O<B

# Halt
Z<1
